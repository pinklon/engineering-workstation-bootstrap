#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODE="${1:-status}"
STAGE_ROOT="${WORKSTATION_STAGE_ROOT:-}"
VERSION="${2:-0.2.0-v2-staged}"
DRIVE_ROOT="${WORKSTATION_DRIVE_ROOT:-$HOME/Library/CloudStorage/GoogleDrive-malott@gmail.com/My Drive}"

require_stage() {
  [[ -n "$STAGE_ROOT" ]] || { printf 'REFUSE: set WORKSTATION_STAGE_ROOT to a disposable non-home target.\n' >&2; exit 64; }
  case "$STAGE_ROOT" in "$HOME"|"$HOME"/*) printf 'REFUSE: staged target must not be inside HOME.\n' >&2; exit 64;; esac
}

render_stage() {
  require_stage
  mkdir -p "$STAGE_ROOT/config/codex" "$STAGE_ROOT/manifests" "$STAGE_ROOT/skills"
  cp "$ROOT/config/codex/config.toml.template" "$STAGE_ROOT/config/codex/config.toml"
  sed -i.bak "s#{{STAGE_ROOT}}#$STAGE_ROOT#g" "$STAGE_ROOT/config/codex/config.toml" && rm -f "$STAGE_ROOT/config/codex/config.toml.bak"
  cp "$ROOT/config/codex/AGENTS.md" "$STAGE_ROOT/config/codex/AGENTS.md"
  cp "$ROOT/manifests/skills.yaml" "$ROOT/manifests/mcp.yaml" "$ROOT/manifests/environment.yaml" "$STAGE_ROOT/manifests/"
  cp -R "$ROOT/skills/workstation-operations" "$STAGE_ROOT/skills/"
  printf '{"schema_version":1,"mode":"staged","status":"ready","secret_values":false}\n' > "$STAGE_ROOT/receipt.json"
}

case "$MODE" in
  status) printf 'STAGED_TARGET=%s\n' "${STAGE_ROOT:-unset}"; printf 'LIVE_ACTIVATION=disabled\n' ;;
  reconcile) render_stage; printf 'PASS: staged reconcile completed\n' ;;
  repair) bash "$ROOT/validation/validate.sh"; render_stage; printf 'PASS: staged repair completed\n' ;;
  rollback) require_stage; case "$STAGE_ROOT" in /private/tmp/*|/tmp/*) rm -rf "$STAGE_ROOT";; *) printf 'REFUSE: rollback accepts only /tmp or /private/tmp staged targets.\n' >&2; exit 64;; esac; printf 'PASS: staged target removed\n' ;;
  package-drive)
    bash "$ROOT/packaging/build-package.sh" "$VERSION"
    candidate="$DRIVE_ROOT/Tony Workstation Bootstrap/current"
    if ! mkdir -p "$candidate/releases" "$candidate/payloads" "$candidate/receipts" 2>/dev/null; then
      checksum="$(awk '{print $1}' "$ROOT/dist/engineering-workstation-bootstrap-$VERSION.tar.gz.sha256")"
      printf '{"schema_version":1,"version":"%s","sha256":"%s","destination":"%s","state":"pending-publish"}\n' "$VERSION" "$checksum" "$candidate" > "$ROOT/dist/drive-pending-publish.json"
      printf 'PENDING: Drive is unavailable; local receipt %s\n' "$ROOT/dist/drive-pending-publish.json"
      exit 0
    fi
    cp "$ROOT/dist/engineering-workstation-bootstrap-$VERSION.tar.gz" "$candidate/payloads/"
    cp "$ROOT/dist/engineering-workstation-bootstrap-$VERSION.tar.gz.sha256" "$candidate/checksums.sha256"
    printf '%s\n' "$VERSION" > "$candidate/VERSION"
    printf '%s\n' 'Read README-FIRST.txt, verify checksums.sha256, then run only after explicit cutover approval.' > "$candidate/README-FIRST.txt"
    printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail' 'echo "Candidate only: verify README-FIRST.txt and checksum before an explicitly authorized cutover."' > "$candidate/START_TONY_WORKSTATION_BOOTSTRAP.command"
    chmod 755 "$candidate/START_TONY_WORKSTATION_BOOTSTRAP.command"
    checksum="$(awk '{print $1}' "$candidate/checksums.sha256")"
    printf '{"schema_version":1,"version":"%s","archive":"payloads/engineering-workstation-bootstrap-%s.tar.gz","sha256":"%s","activation":"pending-explicit-cutover"}\n' "$VERSION" "$VERSION" "$checksum" > "$candidate/manifest.json"
    cp "$candidate/manifest.json" "$candidate/receipts/pending-publish.json"
    printf 'PASS: Drive candidate %s\n' "$candidate"
    ;;
  *) printf 'Usage: staged-workstation {status|reconcile|repair|rollback|package-drive}\n' >&2; exit 64 ;;
esac
