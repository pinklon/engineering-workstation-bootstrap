#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODE="${1:-status}"
STAGE_ROOT="${WORKSTATION_STAGE_ROOT:-}"

require_stage() {
  command -v python3 >/dev/null 2>&1 || { printf 'REFUSE: python3 is required to verify a staged target.\n' >&2; exit 64; }
  STAGE_ROOT="$(python3 - "$STAGE_ROOT" "$HOME" <<'PY'
from pathlib import Path
import sys

raw = Path(sys.argv[1])
home = Path(sys.argv[2]).resolve()

def refuse(message):
    print('REFUSE: ' + message, file=sys.stderr)
    raise SystemExit(64)

if not sys.argv[1] or not raw.is_absolute() or '..' in raw.parts or raw.is_symlink():
    refuse('WORKSTATION_STAGE_ROOT must be an absolute disposable directory, not a symlink.')
stage = raw.resolve()
if stage == home or home in stage.parents:
    refuse('staged target must not be inside HOME.')
temp_roots = {Path('/tmp').resolve(), Path('/private/tmp').resolve()}
if not any(root in stage.parents for root in temp_roots):
    refuse('staged target must be beneath /tmp or /private/tmp so rollback can remove it.')
if stage.exists() and not stage.is_dir():
    refuse('staged target exists but is not a directory.')
print(stage)
PY
)"
}

require_owned_stage() {
  python3 - "$STAGE_ROOT" "$ROOT" <<'PY'
from pathlib import Path
import sys

stage, source = Path(sys.argv[1]), Path(sys.argv[2])
receipt = b'{"schema_version":1,"mode":"staged","status":"ready","secret_values":false}\n'
directories = {'config', 'config/codex', 'docs', 'manifests', 'skills',
               'skills/workstation-operations'}
files = {'AGENTS.md', 'receipt.json', 'config/codex/config.toml',
         'config/codex/AGENTS.md', 'docs/CAPABILITY-MAP.md',
         'docs/CONNECTOR-FABRIC.md', 'docs/AGENT-OPERATING-CONTRACT.md',
         'manifests/skills.yaml', 'manifests/mcp.yaml',
         'manifests/environment.yaml', 'manifests/connector-capabilities.json',
         'manifests/connector-hosted-template.json'}
skill_source = source / 'skills/workstation-operations'
for item in skill_source.rglob('*'):
    relative = str(Path('skills/workstation-operations') / item.relative_to(skill_source))
    (directories if item.is_dir() else files).add(relative)

def refuse():
    print('REFUSE: nonempty staged target is not the unchanged managed stage; preserve its existing policy.', file=sys.stderr)
    raise SystemExit(64)

try:
    if not stage.is_dir():
        refuse()
    if any(item.is_symlink() for item in stage.rglob('*')):
        refuse()
    if {str(item.relative_to(stage)) for item in stage.rglob('*')} != directories | files:
        refuse()
    if any(not (stage / path).is_dir() for path in directories):
        refuse()
    if any(not (stage / path).is_file() for path in files):
        refuse()
    if (stage / 'receipt.json').read_bytes() != receipt:
        refuse()
    if (stage / 'AGENTS.md').read_bytes() != (source / 'AGENTS.md').read_bytes():
        refuse()
except OSError:
    refuse()
PY
}

render_stage() {
  require_stage
  if [[ -d "$STAGE_ROOT" && -n "$(command ls -A "$STAGE_ROOT")" ]]; then
    require_owned_stage
  fi
  mkdir -p "$STAGE_ROOT/config/codex" "$STAGE_ROOT/manifests" "$STAGE_ROOT/skills" "$STAGE_ROOT/docs"
  # Keep the stage's skill lookup chain resolvable without activating a home.
  cp "$ROOT/AGENTS.md" "$STAGE_ROOT/AGENTS.md"
  cp "$ROOT/docs/CAPABILITY-MAP.md" "$ROOT/docs/CONNECTOR-FABRIC.md" \
    "$ROOT/docs/AGENT-OPERATING-CONTRACT.md" "$STAGE_ROOT/docs/"
  cp "$ROOT/config/codex/config.toml.template" "$STAGE_ROOT/config/codex/config.toml"
  sed -i.bak "s#{{STAGE_ROOT}}#$STAGE_ROOT#g" "$STAGE_ROOT/config/codex/config.toml" && rm -f "$STAGE_ROOT/config/codex/config.toml.bak"
  cp "$ROOT/config/codex/AGENTS.md" "$STAGE_ROOT/config/codex/AGENTS.md"
  cp "$ROOT/manifests/skills.yaml" "$ROOT/manifests/mcp.yaml" "$ROOT/manifests/environment.yaml" "$STAGE_ROOT/manifests/"
  cp "$ROOT/manifests/connector-capabilities.json" "$ROOT/manifests/connector-hosted-template.json" "$STAGE_ROOT/manifests/"
  cp -R "$ROOT/skills/workstation-operations" "$STAGE_ROOT/skills/"
  printf '{"schema_version":1,"mode":"staged","status":"ready","secret_values":false}\n' > "$STAGE_ROOT/receipt.json"
}

case "$MODE" in
  status) printf 'STAGED_TARGET=%s\n' "${STAGE_ROOT:-unset}"; printf 'LIVE_ACTIVATION=disabled\n' ;;
  reconcile) render_stage; printf 'PASS: staged reconcile completed\n' ;;
  repair) bash "$ROOT/validation/validate.sh"; render_stage; printf 'PASS: staged repair completed\n' ;;
  rollback) require_stage; require_owned_stage; rm -rf "$STAGE_ROOT"; printf 'PASS: staged target removed\n' ;;
  package-drive)
    printf 'REFUSE: use workstation-publish-drive with an explicit publication contract.\n' >&2
    exit 64
    ;;
  *) printf 'Usage: staged-workstation {status|reconcile|repair|rollback|package-drive}\n' >&2; exit 64 ;;
esac
