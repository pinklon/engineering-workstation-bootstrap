#!/usr/bin/env bash
# Select the Node 24 cloud baseline and persist it for subsequent Bash sessions.
# Configure BASH_ENV=/workspace/.codex-node24/env.sh in environment settings.
# This entrypoint is for disposable managed Linux containers, not live Macs.
set +x
set -eo pipefail
if [[ "$(uname -s)" != Linux || ! -d /workspace ]]; then
  printf '%s\n' 'ERROR: workstation-cloud-node requires a managed Linux /workspace container.' >&2
  exit 1
fi
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [[ ! -s "$NVM_DIR/nvm.sh" ]]; then
  printf '%s\n' 'ERROR: selected cloud image has no NVM; select a Node 24-capable image.' >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$NVM_DIR/nvm.sh"
if [ "$(nvm version 24)" = N/A ]; then nvm install 24; fi
nvm use 24
nvm alias default 24
node -e 'if (process.versions.node.split(".")[0] !== "24") process.exit(1)'
mkdir -p /workspace/.codex-node24
NODE24_BIN="$(dirname "$(command -v node)")"
printf 'export PATH=%q:"$PATH"\n' "$NODE24_BIN" > /workspace/.codex-node24/env.sh
python3 - <<'PY'
from pathlib import Path
p = Path.home() / ".bashrc"
s = p.read_text() if p.exists() else ""
line = '. /workspace/.codex-node24/env.sh'
if line not in s.splitlines():
    p.write_text(line + "\n" + s + "\n" + line + "\n")
PY
export BASH_ENV=/workspace/.codex-node24/env.sh
bash -c 'node -e "if (process.versions.node.split(\".\")[0] !== \"24\") process.exit(1)"'
bash -lc 'node -e "if (process.versions.node.split(\".\")[0] !== \"24\") process.exit(1)"'
node --version
printf '%s\n' NODE24_SETUP_PASS
