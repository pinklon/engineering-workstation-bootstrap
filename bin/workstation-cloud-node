#!/usr/bin/env bash
# Select the declared Node cloud baseline and persist it for subsequent Bash sessions.
# Configure BASH_ENV=/workspace/.codex-node/env.sh in environment settings.
# This entrypoint is for disposable managed Linux containers, not live Macs.
set +x
set -eo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ "$(uname -s)" != Linux || ! -d /workspace ]]; then
  printf '%s\n' 'ERROR: workstation-cloud-node requires a managed Linux /workspace container.' >&2
  exit 1
fi
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [[ ! -s "$NVM_DIR/nvm.sh" ]]; then
  printf '%s\n' 'ERROR: selected cloud image has no NVM; select a Node-capable image.' >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$NVM_DIR/nvm.sh"
NODE_MAJOR="$(python3 - "$ROOT/manifests/cloud.json" <<'PY'
import json
import sys

value = json.load(open(sys.argv[1], encoding="utf-8"))["nodeMajor"]
if not isinstance(value, int) or value < 1:
    raise SystemExit("manifests/cloud.json nodeMajor must be a positive integer")
print(value)
PY
)"
if [ "$(nvm version "$NODE_MAJOR")" = N/A ]; then nvm install "$NODE_MAJOR"; fi
nvm use "$NODE_MAJOR"
nvm alias default "$NODE_MAJOR"
node -e 'if (process.versions.node.split(".")[0] !== process.argv[1]) process.exit(1)' "$NODE_MAJOR"
mkdir -p /workspace/.codex-node
NODE_BIN="$(dirname "$(command -v node)")"
printf "export PATH=%q:\"\$PATH\"\n" "$NODE_BIN" > /workspace/.codex-node/env.sh
python3 - <<'PY'
from pathlib import Path
p = Path.home() / ".bashrc"
s = p.read_text() if p.exists() else ""
line = '. /workspace/.codex-node/env.sh'
if line not in s.splitlines():
    p.write_text(line + "\n" + s + "\n" + line + "\n")
PY
export BASH_ENV=/workspace/.codex-node/env.sh
bash -c 'node -e '\''if (process.versions.node.split(".")[0] !== process.argv[1]) process.exit(1)'\'' "$1"' _ "$NODE_MAJOR"
bash -lc 'node -e '\''if (process.versions.node.split(".")[0] !== process.argv[1]) process.exit(1)'\'' "$1"' _ "$NODE_MAJOR"
node --version
printf 'NODE_SETUP_PASS major=%s\n' "$NODE_MAJOR"
