#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODE="${1:-install}"
PROFILE="${WORKSTATION_PROFILE:-macos-desktop}"
CONFIG_ROOT="${HOME}/.config/engineering-workstation-bootstrap"
TOOL_ROOT="${HOME}/.local/share/engineering-workstation-bootstrap"
RECEIPT_ROOT="${HOME}/.local/state/engineering-workstation-bootstrap/receipts"
ENABLE_CLOUDFLARE="${ENABLE_CLOUDFLARE:-0}"

log() { printf '%s\n' "$*"; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
need_human() { printf '\nACTION REQUIRED: %s\n' "$*"; }

install_xcode_tools() {
  xcode-select -p >/dev/null 2>&1 && return 0
  need_human "Install Apple's command-line developer tools in the macOS dialog, then rerun this command."
  xcode-select --install || true
  exit 10
}

install_homebrew() {
  command -v brew >/dev/null 2>&1 && return 0
  need_human "Homebrew requires an administrator-approved installation."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  if [[ -x /opt/homebrew/bin/brew ]]; then eval "$(/opt/homebrew/bin/brew shellenv)"; fi
  command -v brew >/dev/null 2>&1 || die "Homebrew installation did not become available."
}

install_packages() {
  log "Installing declared host packages..."
  brew bundle --file "$ROOT/Brewfile"
  command -v mise >/dev/null 2>&1 && mise install --cd "$ROOT"
  if [[ "$ENABLE_CLOUDFLARE" == "1" ]]; then
    npm install --global wrangler
  fi
}

managed_include() {
  local target="$1" line="$2"
  touch "$target"
  grep -Fqx "$line" "$target" 2>/dev/null || printf '\n%s\n' "$line" >> "$target"
}

write_wrapper() {
  local name="$1"
  cat > "$HOME/bin/$name" <<EOF
#!/usr/bin/env bash
exec bash "$ROOT/bin/$name" "\$@"
EOF
  chmod 755 "$HOME/bin/$name"
}

configure_host() {
  mkdir -p "$HOME/bin" "$CONFIG_ROOT" "$TOOL_ROOT" "$RECEIPT_ROOT"
  cp "$ROOT/config/shell.zsh" "$CONFIG_ROOT/shell.zsh"
  cp "$ROOT/config/gitconfig" "$CONFIG_ROOT/gitconfig"
  cp "$ROOT/config/ssh-config" "$CONFIG_ROOT/ssh-config"
  # shellcheck disable=SC2016
  managed_include "$HOME/.zshrc" 'source "$HOME/.config/engineering-workstation-bootstrap/shell.zsh"'
  managed_include "$HOME/.gitconfig" '[include]'
  managed_include "$HOME/.gitconfig" '    path = ~/.config/engineering-workstation-bootstrap/gitconfig'
  mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
  managed_include "$HOME/.ssh/config" 'Include ~/.config/engineering-workstation-bootstrap/ssh-config'
  chmod 600 "$HOME/.ssh/config"
  for tool in workstation-bootstrap workstation-doctor github-auth-doctor cloudflare-auth-doctor browser-gate-python environment-inventory; do
    write_wrapper "$tool"
  done
}

enroll_github() {
  if ! gh auth status --hostname github.com >/dev/null 2>&1; then
    need_human "Complete GitHub browser sign-in and multi-factor authentication."
    gh auth login --hostname github.com --git-protocol ssh --web
  fi
  ssh -G git@github.com >/dev/null 2>&1 || die "Secure-shell client configuration is invalid."
  if ! find "$HOME/.ssh" -maxdepth 1 -name '*.pub' -print -quit | grep -q .; then
    local key="$HOME/.ssh/id_ed25519_github"
    need_human "Create a GitHub secure-shell key. You may choose a passphrase at the prompt."
    ssh-keygen -t ed25519 -f "$key" -C "$(gh api user --jq .login)@$(scutil --get ComputerName 2>/dev/null || hostname)"
    gh ssh-key add "$key.pub" --title "$(scutil --get ComputerName 2>/dev/null || hostname)-$(date +%Y-%m-%d)"
  fi
  gh auth setup-git
}

enroll_optional_cloud_provider() {
  [[ "$ENABLE_CLOUDFLARE" == "1" ]] || return 0
  if ! wrangler whoami >/dev/null 2>&1; then
    need_human "Complete optional Cloudflare browser sign-in. No deployment will occur."
    wrangler login
  fi
}

configure_browser_gate() { bash "$ROOT/bootstrap/configure-browser-gate.sh"; }
clone_repositories() { bash "$ROOT/bootstrap/clone-repositories.sh" "$PROFILE"; }
run_doctor() { bash "$ROOT/bin/workstation-doctor" --full; }

case "$MODE" in
  install)
    [[ "$(uname -s)" == "Darwin" ]] || die "install currently supports macOS."
    install_xcode_tools; install_homebrew; install_packages; configure_host
    enroll_github; enroll_optional_cloud_provider; configure_browser_gate; clone_repositories; run_doctor
    ;;
  reconcile)
    install_homebrew; install_packages; configure_host; configure_browser_gate; clone_repositories; run_doctor
    ;;
  status) run_doctor ;;
  dry-run)
    log "Profile: $PROFILE"
    log "Would install declared dependencies, configure managed fragments, enroll required services, configure browser validation, optionally clone repositories, and validate."
    if [[ "$ENABLE_CLOUDFLARE" == "1" ]]; then
      log "Optional Cloudflare support is enabled."
    fi
    ;;
  *) die "Usage: workstation-bootstrap {install|reconcile|status|dry-run}" ;;
esac
